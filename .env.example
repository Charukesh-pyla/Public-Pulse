# Public Priority Platform Configuration

# Database
# Local Docker url: postgresql://postgres:password@localhost:5432/public_priority_db
DATABASE_URL=postgresql://postgres:password@localhost:5432/public_priority_db

# Redis
# Local Docker url: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Supabase Auth & Storage (for client-side or admin SDK queries)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudflare R2 (for evidence storage)
CF_R2_ACCESS_KEY_ID=your-r2-access-key-id
CF_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CF_R2_BUCKET_NAME=public-priority-evidence
CF_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# FastAPI Server Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
PROJECT_NAME="Public Priority Platform API"
ENVIRONMENT=development
PORT=8000
